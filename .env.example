# ============================================================
# .env.example — Variables de entorno requeridas
# IMPORTANTE: Copia este archivo como ".env" y llena los valores
# NUNCA subas el archivo .env real a GitHub
# ============================================================

# Tu URI de conexión a MongoDB Atlas
# Formato: mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/sneakersboot?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://TU_USUARIO:TU_PASSWORD@cluster0.xxxxx.mongodb.net/sneakersboot?retryWrites=true&w=majority

# Tu API Key de Google AI Studio (Gemini)
# Obtenla en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=TU_GEMINI_API_KEY_AQUI

# Puerto del servidor (Railway lo asigna automáticamente)
PORT=3000

# Token de seguridad para las rutas CRUD (Requerido para modificar BD)
ADMIN_TOKEN=tu_secreto_seguro_para_la_api

# (Opcional) Token del Bot de Telegram (Obtenlo usando @BotFather en Telegram)
TELEGRAM_TOKEN=tu_token_de_telegram

# (Opcional) Modelo de Gemini a usar (por defecto gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# (Opcional) URL del frontend para configurar el CORS estricto
FRONTEND_URL=http://localhost:3000
